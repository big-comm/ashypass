# Maintainer: Tales A. Mendonça <talesam@gmail.com>

pkgname=ashypass
pkgdesc="Generate and securely store passwords (Rust/GTK4)"
depends=(
    'gtk4'
    'libadwaita'
    'gcc-libs'
    'glibc'
    'gettext'
    'sqlite'
)
makedepends=(
    'rust'
    'cargo'
    'pkgconf'
    'base-devel'
)
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('x86_64')
license=('MIT')
url="https://github.com/big-comm/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')

if [ -e "${pkgname}.install" ]; then
    install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
    install=pkgbuild.install
fi

prepare() {
    cd "${srcdir}/${pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${srcdir}/${pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --locked \
        --bin ashypass \
        --bin ashypass-cli \
        --bin ashypass-native-host
}

check() {
    cd "${srcdir}/${pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --release --locked --workspace || true
}

package() {
    cd "${srcdir}/${pkgname}"

    install -Dm755 "target/release/ashypass"              "${pkgdir}/usr/bin/ashypass"
    install -Dm755 "target/release/ashypass-cli"          "${pkgdir}/usr/bin/ashypass-cli"
    install -Dm755 "target/release/ashypass-native-host"  "${pkgdir}/usr/lib/${pkgname}/ashypass-native-host"

    if [ -d "usr/share" ]; then
        cp -a usr/share "${pkgdir}/usr/"
    fi

    # Compile and install .po translations as .mo if present.
    if [ -d "locale" ]; then
        for po in locale/*.po; do
            [ -f "$po" ] || continue
            lang=$(basename "$po" .po)
            install -d "${pkgdir}/usr/share/locale/${lang}/LC_MESSAGES"
            msgfmt "$po" -o "${pkgdir}/usr/share/locale/${lang}/LC_MESSAGES/ashypass.mo"
        done
    fi

    install -Dm644 LICENSE        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md      "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 CRYPTO_SPEC.md "${pkgdir}/usr/share/doc/${pkgname}/CRYPTO_SPEC.md"
}
