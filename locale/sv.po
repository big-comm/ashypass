msgstr "Ge denna inloggning ett namn, till exempel webbplatsen eller appen."

msgid "Go to search"
msgstr "Gå till sökning"

msgid "Google Drive"
msgstr "Google Drive"

msgid "Google Drive and WebDAV"
msgstr "Google Drive och WebDAV"

msgid "Helps SSD wear-leveling but leaks free-space patterns to the device."
msgstr ""
