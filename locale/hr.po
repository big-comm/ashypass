msgid ""
"Encrypted vault uploaded as-is over HTTPS. Works with any RFC 4918 server."
msgstr ""
"Šifrirani trezor prenesen kakav jest putem HTTPS-a. Radi s bilo kojim RFC "
"4918 poslužiteljem."

msgid "Encrypted vault uploaded as-is. Folder: \"AshyPass Backups\"."
msgstr ""
"Šifrirani trezor prenesen u izvornom obliku. Mapa: \"AshyPass Backups\"."

msgid "Encrypted zero (recommended — slow but secure)"
msgstr "Enkriptirana nula (preporučeno — sporo, ali sigurno)"

msgid ""
"Encrypting erases the whole drive. Unlock and lock work for LUKS drives."
msgstr ""
"Šifriranje briše cijeli pogon. Otključavanje i zaključavanje rade za LUKS "
"pogone."

