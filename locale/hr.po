msgstr "Registriraj"

msgid "Enrol FIDO2 Token"
msgstr "Registriraj FIDO2 token"

msgid "Enter a label."
msgstr "Unesite oznaku."

msgid "Enter the PIN set up on this computer."
msgstr "Unesite PIN postavljen na ovom računalu."

msgid "Enter the password, or add a verification code below."
msgstr "Unesite lozinku ili dodajte kôd za provjeru u nastavku."

msgid "Enter your PIN"
msgstr "Unesite svoj PIN"

msgid "Enter your master password"
msgstr "Unesite glavnu lozinku"

