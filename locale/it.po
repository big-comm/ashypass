msgid "Enter a label."
msgstr "Inserisci un'etichetta."

msgid "Enter the PIN set up on this computer."
msgstr "Inserisci il PIN configurato su questo computer."

msgid "Enter the password, or add a verification code below."
msgstr "Inserisci la password o aggiungi un codice di verifica qui sotto."

msgid "Enter your PIN"
msgstr "Inserisci il PIN"

msgid "Enter your master password"
msgstr "Inserisci la password principale"

msgid "Enter your master password to access your saved items."
msgstr "Inserisci la password principale per accedere agli elementi salvati."

