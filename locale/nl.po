"dit alleen met een server die je vertrouwt. Log in met een app-wachtwoord "
"uit Instellingen → Beveiliging."

msgid "Type of password"
msgstr "Soort wachtwoord"

msgid "Type the device path shown above."
msgstr "Typ het apparaatpad dat hierboven staat."

msgid "Type the last 4 characters of the serial number shown above."
msgstr "Typ de laatste 4 tekens van het serienummer dat hierboven staat."

msgid "Type the master password first"
msgstr "Typ eerst het hoofdwachtwoord"

msgid "URL, username and password are required"
msgstr "URL, gebruikersnaam en wachtwoord zijn vereist"

msgid "Understood"
msgstr "Begrepen"

msgid "Undo"
msgstr "Ongedaan maken"

msgid "Unencrypted JSON export"
msgstr "Onversleutelde JSON-export"

msgid "Unlock"
msgstr "Ontgrendelen"

msgid "Unlock Drive"
msgstr "Schijf ontgrendelen"

msgid "Unlock Vault"
msgstr "Kluis ontgrendelen"

msgid "Unlock the vault first"
msgstr "Ontgrendel eerst de kluis"

