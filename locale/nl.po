msgid ""
"Adding entries works with .ashy copies. For a .db copy, choose “Replace”."
msgstr ""
"Items toevoegen werkt met .ashy-kopieën. Kies voor een .db-kopie “Vervangen”."

msgid "Address copied"
msgstr "Adres gekopieerd"

msgid "Address, user and password are required"
msgstr "Adres, gebruiker en wachtwoord zijn verplicht"

msgid "Adjust length and characters"
msgstr "Lengte en tekens aanpassen"

msgid "Adjust number of digits"
msgstr "Aantal cijfers aanpassen"

