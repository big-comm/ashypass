msgid ""
"Adding entries works with .ashy copies. For a .db copy, choose “Replace”."
msgstr ""
"Að bæta við færslum virkar með .ashy-afritum. Fyrir .db-afrit skaltu velja "
"„Skipta út“."

msgid "Address copied"
msgstr "Vistfang afritað"

