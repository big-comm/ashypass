msgstr "Registrer FIDO2-nøgle"

msgid "Enter a label."
msgstr "Angiv en etiket."

msgid "Enter the PIN set up on this computer."
msgstr "Indtast den PIN-kode, der er sat op på denne computer."

msgid "Enter the password, or add a verification code below."
msgstr "Indtast adgangskoden, eller tilføj en bekræftelseskode nedenfor."

msgid "Enter your PIN"
msgstr "Indtast din PIN-kode"

msgid "Enter your master password"
msgstr "Indtast din hovedadgangskode"

msgid "Enter your master password to access your saved items."
msgstr ""
"Indtast din hovedadgangskode for at få adgang til dine gemte elementer."

