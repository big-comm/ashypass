msgstr "Krypteret enhed"

msgid "Encrypted snapshot upload with conflict detection"
msgstr "Krypteret snapshot-upload med konfliktdetektering"

msgid ""
"Encrypted vault uploaded as-is over HTTPS. Works with any RFC 4918 server."
msgstr ""
"Krypteret boks uploadet som den er via HTTPS. Fungerer med enhver RFC 4918-"
"server."

msgid "Encrypted vault uploaded as-is. Folder: \"AshyPass Backups\"."
msgstr "Krypteret boks uploadet som den er. Mappe: \"AshyPass Backups\"."

msgid "Encrypted zero (recommended — slow but secure)"
msgstr "Krypteret nul (anbefales — langsom, men sikker)"

msgid ""
"Encrypting erases the whole drive. Unlock and lock work for LUKS drives."
msgstr ""
"Kryptering sletter hele drevet. Oplåsning og låsning virker for LUKS-drev."

msgid "Encrypting…"
msgstr "Krypterer…"

