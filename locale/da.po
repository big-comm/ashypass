msgid "1PUX export file"
msgstr "1PUX-eksportfil"

msgid ""
"A .ashy copy made by Ashy Pass, or a .db copy downloaded from Google Drive "
"or WebDAV."
msgstr ""
"En .ashy-kopi lavet af Ashy Pass eller en .db-kopi hentet fra Google Drive "
"eller WebDAV."

msgid "A 12-word BIP-39 phrase to unlock without a security key. Shown once."
msgstr ""
"En 12-ords BIP-39-sætning til at låse op uden en sikkerhedsnøgle. Vises én "
"gang."

msgid "A new access"
msgstr "Et nyt login"

msgid "A new password to use on a website or app."
msgstr "En ny adgangskode til brug på et websted eller i en app."

msgid ""
"A password is incorrect: the file password or the master password of the "
"copy. Nothing was changed."
msgstr ""
"En adgangskode er forkert: filens adgangskode eller kopiens "
"hovedadgangskode. Intet blev ændret."

msgid "A warning appears before it locks, with time to keep using it"
msgstr "En advarsel vises, før den låses, med tid til at fortsætte"

msgid "About Ashy Pass"
msgstr "Om Ashy Pass"

msgid "About the backup"
msgstr "Om sikkerhedskopien"

msgid "Add FIDO2 token keyslot"
msgstr "Tilføj FIDO2-nøgleplads"

msgid "Add a hardware token keyslot"
msgstr "Tilføj en hardwarenøgle-nøgleplads"

msgid "Add a number"
msgstr "Tilføj et tal"

msgid "Add an existing tag"
msgstr "Tilføj et eksisterende tag"

