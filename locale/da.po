msgstr "ledig"

msgid "free of"
msgstr "ledig af"

msgid "high"
msgstr "høj"

msgid "incorrect master password"
msgstr "forkert hovedadgangskode"

msgid "low"
msgstr "lav"

msgid "medium"
msgstr "middel"

msgid "minute"
msgid_plural "minutes"
msgstr[0] "minut"
msgstr[1] "minutter"

