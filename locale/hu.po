msgstr "Válassza ki az 1Password exportot"

msgid "Choose the Aegis export"
msgstr "Válassza ki az Aegis exportot"

msgid "Choose the Ashy Pass backup"
msgstr "Válassza ki az Ashy Pass mentést"

msgid "Choose the Bitwarden export"
msgstr "Válassza ki a Bitwarden exportot"

msgid "Choose the CSV file"
msgstr "Válassza ki a CSV fájlt"

msgid "Choose the KeePass database"
msgstr "Válassza ki a KeePass adatbázist"

msgid "Choose the andOTP export"
msgstr "Válassza ki az andOTP exportot"

