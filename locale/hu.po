msgid ""
"Adding entries works with .ashy copies. For a .db copy, choose “Replace”."
msgstr ""
"A bejegyzések hozzáadása .ashy másolatokkal működik. .db másolat esetén "
"válassza a „Csere” lehetőséget."

msgid "Address copied"
msgstr "Cím másolva"

