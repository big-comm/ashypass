msgid "1PUX export file"
msgstr "Exportný súbor 1PUX"

msgid ""
"A .ashy copy made by Ashy Pass, or a .db copy downloaded from Google Drive "
"or WebDAV."
msgstr ""
"Kópia .ashy vytvorená v Ashy Pass alebo kópia .db stiahnutá z Google Drive "
"alebo WebDAV."

msgid "A 12-word BIP-39 phrase to unlock without a security key. Shown once."
msgstr ""
"12-slovná fráza BIP-39 na odomknutie bez bezpečnostného kľúča. Zobrazí sa "
"iba raz."

msgid "A new access"
msgstr "Nový prístup"

msgid "A new password to use on a website or app."
msgstr "Nové heslo na použitie na webe alebo v aplikácii."

msgid ""
"A password is incorrect: the file password or the master password of the "
"copy. Nothing was changed."
msgstr ""
"Niektoré heslo je nesprávne: heslo súboru alebo hlavné heslo kópie. Nič sa "
"nezmenilo."

msgid "A warning appears before it locks, with time to keep using it"
msgstr "Pred uzamknutím sa zobrazí upozornenie s časom na ďalšie používanie"

msgid "About Ashy Pass"
msgstr "O aplikácii Ashy Pass"

msgid "About the backup"
msgstr "O zálohe"

msgid "Add FIDO2 token keyslot"
msgstr "Pridať slot kľúča tokenu FIDO2"

msgid "Add a hardware token keyslot"
msgstr "Pridať slot pre hardvérový token"

msgid "Add a number"
msgstr "Pridať číslo"

