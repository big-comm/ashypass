msgid "I understand — Continue"
msgstr "이해했습니다 — 계속"

msgid ""
"If this computer is lost or damaged, a backup is the only way to get your "
"passwords back."
msgstr ""
"이 컴퓨터를 잃어버리거나 고장 나면 백업만이 비밀번호를 되찾는 유일한 방법입니"
"다."

msgid "Images"
msgstr "이미지"

msgid "Import"
msgstr "가져오기"

msgid "Import complete"
msgstr "가져오기 완료"

msgid "Import partly complete"
msgstr "일부만 가져옴"

msgid "Import passwords"
msgstr "비밀번호 가져오기"

