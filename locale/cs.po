msgid "1PUX export file"
msgstr "Exportní soubor 1PUX"

msgid ""
"A .ashy copy made by Ashy Pass, or a .db copy downloaded from Google Drive "
"or WebDAV."
msgstr ""
"Kopie .ashy vytvořená aplikací Ashy Pass nebo kopie .db stažená z Google "
"Drive či WebDAV."

msgid "A 12-word BIP-39 phrase to unlock without a security key. Shown once."
msgstr ""
"12slovná fráze BIP-39 pro odemknutí bez bezpečnostního klíče. Zobrazena "
"pouze jednou."

msgid "A new access"
msgstr "Nová položka"

msgid "A new password to use on a website or app."
msgstr "Nové heslo pro web nebo aplikaci."

msgid ""
"A password is incorrect: the file password or the master password of the "
"copy. Nothing was changed."
msgstr ""
"Heslo je nesprávné: heslo souboru nebo hlavní heslo kopie. Nic nebylo "
"změněno."

msgid "A warning appears before it locks, with time to keep using it"
msgstr "Před uzamčením se zobrazí upozornění s časem pokračovat v práci"

msgid "About Ashy Pass"
msgstr "O aplikaci Ashy Pass"

msgid "About the backup"
msgstr "O záloze"

