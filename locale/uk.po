msgid ""
"Encrypted vault uploaded as-is over HTTPS. Works with any RFC 4918 server."
msgstr ""
"Зашифроване сховище завантажується як є через HTTPS. Працює з будь-яким "
"сервером RFC 4918."

msgid "Encrypted vault uploaded as-is. Folder: \"AshyPass Backups\"."
msgstr "Зашифроване сховище завантажено як є. Тека: \"AshyPass Backups\"."

msgid "Encrypted zero (recommended — slow but secure)"
msgstr "Зашифрований нуль (рекомендовано — повільно, але безпечно)"

msgid ""
"Encrypting erases the whole drive. Unlock and lock work for LUKS drives."
msgstr ""
"Шифрування стирає весь диск. Розблокування і блокування працюють для дисків "
"LUKS."

msgid "Encrypting…"
msgstr "Шифрування…"

msgid "Encrypt…"
