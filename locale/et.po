msgstr "Krüptitud hetktõmmise üleslaadimine konfliktituvastusega"

msgid ""
"Encrypted vault uploaded as-is over HTTPS. Works with any RFC 4918 server."
msgstr ""
"Krüptitud varahoidla fail laaditakse üles HTTPS-i kaudu. Töötab iga RFC 4918 "
"serveriga."

msgid "Encrypted vault uploaded as-is. Folder: \"AshyPass Backups\"."
msgstr ""
"Krüptitud varahoid laeti üles muutmata kujul. Kaust: \"AshyPass Backups\"."

msgid "Encrypted zero (recommended — slow but secure)"
msgstr "Krüpteeritud null (soovitatav – aeglane, kuid turvaline)<br>"

msgid ""
"Encrypting erases the whole drive. Unlock and lock work for LUKS drives."
msgstr ""
"Krüptimine kustutab kogu ketta. Avamine ja lukustamine toimivad LUKS-"
"ketastega."

msgid "Encrypting…"
msgstr "Krüpteerimine…<br>"

msgid "Encrypt…"
msgstr "Krüpti…"

msgid "Enrol"
msgstr "Registreeri"

msgid "Enrol FIDO2 Token"
msgstr "Registreeri FIDO2 võti"

msgid "Enter a label."
msgstr "Sisesta silt."

msgid "Enter the PIN set up on this computer."
msgstr "Sisesta selles arvutis seadistatud PIN."

msgid "Enter the password, or add a verification code below."
msgstr "Sisesta parool või lisa allpool kinnituskood."

msgid "Enter your PIN"
msgstr "Sisesta oma PIN"

msgid "Enter your master password"
msgstr "Sisesta oma põhiparool"

msgid "Enter your master password to access your saved items."
msgstr "Salvestatud üksustele juurdepääsuks sisesta oma põhiparool."

