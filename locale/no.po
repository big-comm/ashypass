msgstr "Kunne ikke skanne stasjoner"

msgid "Failed to unlock vault"
msgstr "Klarte ikke å låse opp hvelvet"

msgid "Favorite"
msgstr "Favoritt"

msgid "Favorites"
msgstr "Favoritter"

