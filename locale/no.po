msgstr ""
"Denne stasjonen har ingen lenke i /dev/disk/by-id, så Ashy Pass kan ikke "
"sikre at det fortsatt er samme stasjon når den slettes. Den kan ikke "
"krypteres her."

msgid "This file can be read without a password"
msgstr "Denne filen kan leses uten passord"

msgid "This file could not be read"
msgstr "Denne filen kunne ikke leses"

msgid "This file is too large to attach. The limit is 64 MB."
msgstr "Filen er for stor til å legges ved. Grensen er 64 MB."

