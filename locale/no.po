msgstr ""
"Hvelvet ble låst før sikkerhetskopien ble lagret. Lås det opp og opprett "
"sikkerhetskopien på nytt."

msgid ""
"The vault was locked before the export was saved. Unlock it and export again."
msgstr ""
"Hvelvet ble låst før eksporten ble lagret. Lås det opp og eksporter på nytt."

#, rust-format
msgid "The vault will lock in {} second because of inactivity."
msgid_plural "The vault will lock in {} seconds because of inactivity."
msgstr[0] "Hvelvet låses om {} sekund på grunn av inaktivitet."
msgstr[1] "Hvelvet låses om {} sekunder på grunn av inaktivitet."

