msgid "1PUX export file"
msgstr "1PUX-eksportfil"

msgid ""
"A .ashy copy made by Ashy Pass, or a .db copy downloaded from Google Drive "
"or WebDAV."
msgstr ""
"En .ashy-kopi laget av Ashy Pass, eller en .db-kopi lastet ned fra Google "
"Drive eller WebDAV."

msgid "A 12-word BIP-39 phrase to unlock without a security key. Shown once."
msgstr ""
"En 12-ords BIP-39-frase for å låse opp uten sikkerhetsnøkkel. Vises én gang."

msgid "A new access"
msgstr "En ny pålogging"

msgid "A new password to use on a website or app."
msgstr "Et nytt passord til bruk på et nettsted eller i en app."

msgid ""
"A password is incorrect: the file password or the master password of the "
"copy. Nothing was changed."
msgstr ""
"Et passord er feil: filens passord eller kopiens hovedpassord. Ingenting ble "
"endret."

msgid "A warning appears before it locks, with time to keep using it"
msgstr "Et varsel vises før den låses, med tid til å fortsette"

msgid "About Ashy Pass"
msgstr "Om Ashy Pass"

msgid "About the backup"
msgstr "Om sikkerhetskopien"

msgid "Add FIDO2 token keyslot"
msgstr "Legg til FIDO2-nøkkelspor"

msgid "Add a hardware token keyslot"
msgstr "Legg til en nøkkellomme for maskinvare-nøkkel"

