msgstr "Skriv inn de siste 4 tegnene i serienummeret som vises ovenfor."

msgid "Type the master password first"
msgstr "Skriv inn hovedpassordet først"

msgid "URL, username and password are required"
msgstr "URL, brukernavn og passord er påkrevd"

msgid "Understood"
msgstr "Forstått"

msgid "Undo"
msgstr "Angre"

