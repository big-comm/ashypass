msgid ""
"Encrypted vault uploaded as-is over HTTPS. Works with any RFC 4918 server."
msgstr ""
"Zaszyfrowany sejf przesłany w oryginalnej postaci przez HTTPS. Działa z "
"każdym serwerem zgodnym z RFC 4918."

msgid "Encrypted vault uploaded as-is. Folder: \"AshyPass Backups\"."
msgstr ""
"Zaszyfrowany sejf przesłany w oryginalnej formie. Folder: „AshyPass Backups”."

msgid "Encrypted zero (recommended — slow but secure)"
msgstr "Zaszyfrowane zerowanie (zalecane — wolne, ale bezpieczne)"

msgid ""
"Encrypting erases the whole drive. Unlock and lock work for LUKS drives."
msgstr ""
"Szyfrowanie wymazuje cały dysk. Odblokowywanie i blokowanie działa dla "
"dysków LUKS."

