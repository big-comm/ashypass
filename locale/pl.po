msgstr "Zarejestruj"

msgid "Enrol FIDO2 Token"
msgstr "Zarejestruj token FIDO2"

msgid "Enter a label."
msgstr "Wpisz etykietę."

msgid "Enter the PIN set up on this computer."
msgstr "Wpisz kod PIN ustawiony na tym komputerze."

